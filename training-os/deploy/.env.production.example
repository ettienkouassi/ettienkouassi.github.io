# ---------------------------------------------------------------
# TRAINING OS AI — PRODUCTION (docker compose). Ne JAMAIS commiter ce fichier rempli.
# Générer chaque secret : openssl rand -base64 48
# ---------------------------------------------------------------
APP_ENV=production
APP_URL=https://app.trainingos.ai
VERIFY_URL=https://verify.trainingos.ai
APP_DOMAIN=app.trainingos.ai
VERIFY_DOMAIN=verify.trainingos.ai
# Domaines servis en HTTPS par Caddy (un seul si VERIFY_URL = APP_URL)
CADDY_SITES=app.trainingos.ai, verify.trainingos.ai
ACME_EMAIL=admin@trainingos.ai

POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

APP_SECRET=
CRON_SECRET=
SESSION_TTL_HOURS=12

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TRAINING OS AI <no-reply@trainingos.ai>"

STORAGE_DRIVER=local
# ou STORAGE_DRIVER=s3 + S3_ENDPOINT / S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY

BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
