# Reverse proxy HTTPS automatique (certificats Let's Encrypt).
# Remplacer les domaines par les vôtres (DNS A/AAAA pointant vers le serveur).
{
	email {$ACME_EMAIL}
}

# CADDY_SITES : « app.domaine » ou « app.domaine, verify.domaine »
{$CADDY_SITES} {
	encode zstd gzip
	# Taille max des téléversements (supports de cours : 50 Mo)
	request_body {
		max_size 60MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
		format json
	}
}
