# ---------------------------------------------------------------
# TRAINING OS AI — variables d'environnement
# Copier en .env (dev) ; en staging/production, définir ces valeurs
# dans le gestionnaire de secrets de l'hébergeur (JAMAIS dans Git).
# ---------------------------------------------------------------

APP_ENV=development                 # development | staging | production
APP_URL=http://localhost:3000       # URL publique de l'application (sans / final)
VERIFY_URL=http://localhost:3000    # Domaine de vérification des certificats (ex. https://verify.trainingos.ai)

# Base PostgreSQL
# - DATABASE_URL : rôle applicatif SANS privilège (soumis au Row Level Security)
# - DATABASE_MIGRATION_URL : rôle propriétaire, utilisé uniquement pour les migrations
DATABASE_URL=postgres://trainingos_app:app_password_change_me@localhost:5432/trainingos
DATABASE_MIGRATION_URL=postgres://trainingos_owner:owner_password_change_me@localhost:5432/trainingos
DATABASE_SSL=false                  # true en staging/production

# Sécurité
SESSION_TTL_HOURS=12
# Secret aléatoire (>= 32 caractères) : openssl rand -base64 48
APP_SECRET=change-me-with-openssl-rand-base64-48-xxxxxxxxxxxx
# Secret partagé pour les tâches planifiées (/api/cron/*)
CRON_SECRET=change-me-cron-secret-xxxxxxxxxxxxxxxx

# IA (côté serveur uniquement — jamais exposé au navigateur)
AI_PROVIDER=anthropic               # anthropic | mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium                    # low | medium | high

# Email (SMTP : Brevo, Mailjet, SES, Resend SMTP, etc.). Vide = emails écrits dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TRAINING OS AI <no-reply@trainingos.ai>"

# Stockage des fichiers : local (dev) | s3 (S3, Cloudflare R2, Scaleway, Backblaze…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
